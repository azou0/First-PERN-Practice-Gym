generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//create a table

model training_plans {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id String @db.Uuid
  plan_json Json
  plan_text String
  version Int @default(1)
  @@index( [user_id], map: "idx_training_plans_user_id")
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model user_profiles {
  user_id String @id @db.Uuid //@id means it is the primary key; UUID: Universally Unique Identifiers
  goal String @db.VarChar(20)
  experience String @db.VarChar(20)
  days_per_week Int
  sessionLength Int
  equipment     String  @db.VarChar(20)
  injuries String? //means this field is optional
  preferredSplit String @db.VarChar(20)
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}